# Copy to .env.local (never commit real values). On Vercel, set these in
# Project Settings -> Environment Variables.

# Amazon Creators API (replaced PA-API 5 in 2026). OAuth2 client credentials
# from Associates Central -> Tools -> Creators API.
AMAZON_CREDENTIAL_ID=
AMAZON_CREDENTIAL_SECRET=
# 3.1 = Login with Amazon, North America (credential IDs starting amzn1.application-oa2-client)
AMAZON_CREDENTIAL_VERSION=3.1
# Amazon Associates tracking ID. Defaults to mindfulmar026-20 when unset.
AMAZON_PARTNER_TAG=mindfulmar026-20
AMAZON_MARKETPLACE=www.amazon.com

# Contact form delivery via Resend (https://resend.com). Without these the
# form reports that messaging is unavailable instead of silently dropping mail.
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=ClearanceStream <contact@clearancestream.com>
